VITE_APP_TITLE_SUFFIX=| University of Oakfield
VITE_BACKEND_BASE_URL=
#VITE_BACKEND_ANALYSIS_SERVICE_URL only required for warmup via user browser, not direct calls
VITE_BACKEND_ANALYSIS_SERVICE_URL=

#Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_UPLOAD_URL=http://api.cloudinary.com/v1_1/{##USE_VITE_CLOUDINARY_CLOUD_NAME_HERE##}}/image/upload

#Testing
#Also stored in Github as a 'secret'
VERCEL_AUTOMATION_BYPASS_SECRET=
#Also stored in Github as a 'variable'
STAGING_FRONTEND_URL=
STAGING_BACKEND_URL=

#Note, no need for a [NODE_ENV=] flag here as VITE auto-handles this, injecting dev/prod depending on the npm-run-x cmd called
#(As opposed to serverside which I handle during deployment)