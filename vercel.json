{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cloudinary.com https://vercel.live; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cloudinary.com; connect-src 'self';"
        }
      ]
    }
  ],"rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
